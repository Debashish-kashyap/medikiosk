# Comma-separated browser origins. Use explicit HTTPS origins in production.
MEDIKIOSK_CORS=http://localhost:5173
# Generate once using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDIKIOSK_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Prototype only. This code never calls an official ABHA API.
MEDIKIOSK_ABHA_MODE=mock
# Required only after sanctioned ABDM sandbox onboarding; do not add real values to Git.
MEDIKIOSK_ABDM_SANDBOX_ABHA_LINK_URL=
MEDIKIOSK_ABDM_SANDBOX_FHIR_URL=
MEDIKIOSK_ABDM_CLIENT_ID=
MEDIKIOSK_ABDM_CLIENT_SECRET=
# Optional existing settings
MEDIKIOSK_ASR=stub
MEDIKIOSK_LLM=false
