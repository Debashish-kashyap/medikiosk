# ====================================================================
# MediKiosk Configuration (.env.example)
# ====================================================================

# Comma-separated browser origins. Use explicit HTTPS origins in production.
MEDIKIOSK_CORS=*

# Enable a real, schema-constrained LLM for speech->field mapping & summary phrasing.
# Leave unset to use the offline deterministic alias matcher (no key needed).
# MEDIKIOSK_LLM=openai
# OPENAI_API_KEY=sk-...

# Offline ASR (Lane 4). Options:
#   - whisper: Faster-Whisper (OpenAI Whisper, works well for Indian languages)
#   - stub: No ASR (use browser Web Speech API or no voice input)
# For Whisper: Model downloads from HuggingFace on first use
# MEDIKIOSK_ASR=auto  # auto-detect, uses whisper if available

# Whisper model size: tiny, base, small, medium, large (tiny is default)
# tiny is fastest (~39MB), large is most accurate (~1.5GB)
# MEDIKIOSK_WHISPER_MODEL=tiny

# --- Frontend ---
VITE_API_BASE=http://localhost:8000
# 1 = always POST mic audio to /api/asr (skip browser Web Speech). Needs backend whisper.
# VITE_USE_SERVER_ASR=1

# Google AI Studio Gemini API Key (Lane 5 - Multimodal Vision & NLU)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Gemini Model (e.g., gemini-3.6-flash, gemini-1.5-flash)
GEMINI_MODEL="gemini-3.6-flash"

# ASR Mode: "auto" (faster-whisper if available, else stub), "whisper", or "stub"
MEDIKIOSK_ASR="auto"

# LLM Mode: 1 / true / gemini to enable bounded NLU
MEDIKIOSK_LLM="1"
