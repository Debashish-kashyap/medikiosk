# ====================================================================
# MediKiosk Backend Configuration (.env)
# ====================================================================

# Google AI Studio Gemini API Key (Lane 5 - Multimodal Vision & NLU)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Gemini Model (e.g., gemini-3.6-flash, gemini-1.5-flash)
GEMINI_MODEL="gemini-3.6-flash"

# ASR Mode: "auto" (faster-whisper if available, else stub), "whisper", or "stub"
MEDIKIOSK_ASR="auto"

# LLM Mode: 1 / true / gemini to enable bounded NLU
MEDIKIOSK_LLM="1"

# CORS origins (default "*")
MEDIKIOSK_CORS="*"

# Bhashini (backend-only; service IDs come from Bhashini pipeline configuration)
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""
BHASHINI_INFERENCE_KEY=""
BHASHINI_ASR_SERVICE_ID=""
BHASHINI_TTS_SERVICE_ID=""
BHASHINI_TTS_GENDER="female"
